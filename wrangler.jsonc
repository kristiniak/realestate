// Nastavenie Cloudflare Workera (nemeň, ak nevieš presne čo robíš)
{
  "name": "onyx",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // celý web (html, obrázky, json) sa servíruje ako doteraz; worker.js rieši len adresy /api/…
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Verejné ID z Discordu (nie sú tajné). Token bota a Client Secret patria do Cloudflare ako Secret!
  "vars": {
    "DISCORD_CLIENT_ID": "1557328761505054720",
    "DISCORD_GUILD_ID": "1556773571550908500",
    "DISCORD_CATEGORY_ID": "1557074996797505556",
    "DISCORD_STAFF_ROLE_ID": "1556944091122770010,1556944236971298818",
    // Public Key z Developer Portal → General Information (tlačidlo Copy)
    "DISCORD_PUBLIC_KEY": "SEM-VLOZTE-PUBLIC-KEY",
    // ID kanála, kam sa ukladajú prepisy uzavretých ticketov (pravý klik na kanál → Copy Channel ID)
    "DISCORD_TRANSCRIPT_CHANNEL_ID": "SEM-VLOZTE-ID-KANALA"
  },
  // secrets nastavené v Cloudflare (Variables and Secrets) sa pri nasadení nezmažú
  "keep_vars": true,
  "observability": { "enabled": true }
}
